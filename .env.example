# URL base de la API. En desarrollo se deja vacía y se usa el proxy de Vite
# (ver vite.config.ts), que redirige /api y /ws hacia el backend en :8000.
VITE_API_BASE_URL=
VITE_WS_URL=ws://localhost:8000/ws/detections

# true = la app responde con datos de demostración (src/mocks) sin necesitar
# el backend. Usuarios: U20210452, DOC-202101, EMP-09214, EMP-00001
# (contraseña UNIVO*2026). Vacío o false = API real.
VITE_USE_MOCKS=false
